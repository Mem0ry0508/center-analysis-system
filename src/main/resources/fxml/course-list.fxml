<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.center.ui.CourseListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleBack" text="&lt; 返回主選單"/>
            <Label styleClass="title" text="課程管理"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" onAction="#handleSearch" promptText="依課程名稱搜尋"/>
            <Button onAction="#handleSearch" text="搜尋"/>
            <Button onAction="#handleAdd" text="新增"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="160.0" text="課程名稱"/>
                <TableColumn fx:id="instructorIdColumn" prefWidth="90.0" text="授課老師ID"/>
                <TableColumn fx:id="capacityColumn" prefWidth="70.0" text="名額"/>
                <TableColumn fx:id="classTimeSlotColumn" prefWidth="120.0" text="上課時段"/>
                <TableColumn fx:id="classroomColumn" prefWidth="100.0" text="教室"/>
                <TableColumn fx:id="statusColumn" prefWidth="90.0" text="狀態"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleRefresh" text="重新整理"/>
            <Button onAction="#handleEdit" text="編輯"/>
            <Button onAction="#handleDeactivate" text="停課"/>
        </HBox>
    </bottom>
</BorderPane>
