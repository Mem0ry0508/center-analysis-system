<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.center.ui.PersonListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleBack" text="&lt; 返回主選單"/>
            <Label styleClass="title" text="人員管理"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" onAction="#handleSearch" promptText="依姓名搜尋"/>
            <Button onAction="#handleSearch" text="搜尋"/>
            <TextField fx:id="jumpIdField" onAction="#handleJumpToId" prefWidth="90.0" promptText="跳到編號"/>
            <Button onAction="#handleJumpToId" text="跳號"/>
            <Button onAction="#handleAdd" text="新增"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="120.0" text="姓名"/>
                <TableColumn fx:id="genderColumn" prefWidth="60.0" text="性別"/>
                <TableColumn fx:id="occupationColumn" prefWidth="120.0" text="職業"/>
                <TableColumn fx:id="mobilePhoneColumn" prefWidth="120.0" text="手機"/>
                <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email"/>
                <TableColumn fx:id="statusColumn" prefWidth="80.0" text="狀態"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleSortByName" text="依姓名排序"/>
            <Button onAction="#handleSortById" text="依編號排序"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleRefresh" text="重新整理"/>
            <Button onAction="#handleEdit" text="編輯"/>
            <Button onAction="#handleDeactivate" text="停用"/>
        </HBox>
    </bottom>
</BorderPane>
