<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.center.ui.ContactRecordListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleBack" text="&lt; 返回主選單"/>
            <Label styleClass="title" text="聯絡紀錄"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleAdd" text="新增"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="personIdColumn" prefWidth="80.0" text="人員ID"/>
                <TableColumn fx:id="contactDateColumn" prefWidth="150.0" text="聯絡時間"/>
                <TableColumn fx:id="methodColumn" prefWidth="90.0" text="方式"/>
                <TableColumn fx:id="resultColumn" prefWidth="120.0" text="結果"/>
                <TableColumn fx:id="nextContactDateColumn" prefWidth="110.0" text="下次聯絡日"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleRefresh" text="重新整理"/>
            <Button onAction="#handleEdit" text="編輯"/>
            <Button onAction="#handleDelete" text="刪除"/>
        </HBox>
    </bottom>
</BorderPane>
