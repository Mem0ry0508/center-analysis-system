<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.center.ui.BookListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleBack" text="&lt; 返回主選單"/>
            <Label styleClass="title" text="庫存管理"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleShowLowStock" text="只看低於安全庫存"/>
            <Button onAction="#handleRecordSale" text="記錄銷售"/>
            <Button onAction="#handleAdd" text="新增書籍"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="titleColumn" prefWidth="180.0" text="書名"/>
                <TableColumn fx:id="isbnColumn" prefWidth="130.0" text="ISBN"/>
                <TableColumn fx:id="categoryColumn" prefWidth="90.0" text="分類"/>
                <TableColumn fx:id="currentStockColumn" prefWidth="80.0" text="現有庫存"/>
                <TableColumn fx:id="safetyStockColumn" prefWidth="80.0" text="安全庫存"/>
                <TableColumn fx:id="supplierColumn" prefWidth="120.0" text="供應商"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleRefresh" text="重新整理"/>
            <Button onAction="#handleEdit" text="編輯"/>
        </HBox>
    </bottom>
</BorderPane>
