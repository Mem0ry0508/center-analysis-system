<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.center.ui.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleBack" text="&lt; 返回主選單"/>
            <Label styleClass="title" text="儀表板"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleGoToAnalytics" text="營運分析"/>
            <Button onAction="#handleRefresh" text="重新整理"/>
        </HBox>
    </top>
    <center>
        <GridPane hgap="16.0" vgap="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0" right="24.0" bottom="24.0" left="24.0"/>
            </padding>
            <VBox alignment="CENTER" onMouseClicked="#handleGoToPerson" styleClass="stat-tile"
                  GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label fx:id="totalPeopleValue" styleClass="stat-value" text="0"/>
                <Label text="總人數"/>
            </VBox>
            <VBox alignment="CENTER" onMouseClicked="#handleGoToPerson" styleClass="stat-tile"
                  GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label fx:id="activePeopleValue" styleClass="stat-value" text="0"/>
                <Label text="有效學員數"/>
            </VBox>
            <VBox alignment="CENTER" onMouseClicked="#handleGoToCourse" styleClass="stat-tile"
                  GridPane.rowIndex="0" GridPane.columnIndex="2">
                <Label fx:id="ongoingCourseValue" styleClass="stat-value" text="0 / 0"/>
                <Label text="進行中課程 / 總課程"/>
            </VBox>
            <VBox alignment="CENTER" onMouseClicked="#handleGoToAlert" styleClass="stat-tile"
                  GridPane.rowIndex="1" GridPane.columnIndex="0">
                <Label fx:id="openAlertValue" styleClass="stat-value" text="0"/>
                <Label text="未結案警示"/>
            </VBox>
            <VBox alignment="CENTER" onMouseClicked="#handleGoToBook" styleClass="stat-tile"
                  GridPane.rowIndex="1" GridPane.columnIndex="1">
                <Label fx:id="lowStockValue" styleClass="stat-value" text="0"/>
                <Label text="低於安全庫存書籍"/>
            </VBox>
            <VBox alignment="CENTER" onMouseClicked="#handleGoToContact" styleClass="stat-tile"
                  GridPane.rowIndex="1" GridPane.columnIndex="2">
                <Label fx:id="overdueContactValue" styleClass="stat-value" text="0"/>
                <Label text="逾期未回訪聯絡"/>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
