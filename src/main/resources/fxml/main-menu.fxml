<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.center.ui.MainMenuController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Label fx:id="welcomeLabel" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleLogout" text="登出"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" maxWidth="360.0" spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
            </padding>
            <Button maxWidth="Infinity" onAction="#handlePerson" styleClass="menu-button" text="人員管理"/>
            <Button maxWidth="Infinity" onAction="#handleCourse" styleClass="menu-button" text="課程管理"/>
            <Button maxWidth="Infinity" onAction="#handleContact" styleClass="menu-button" text="聯絡紀錄"/>
            <Button maxWidth="Infinity" onAction="#handleInventory" styleClass="menu-button" text="庫存管理"/>
            <Button maxWidth="Infinity" onAction="#handleDashboard" styleClass="menu-button" text="儀表板"/>
            <Button maxWidth="Infinity" onAction="#handleAnalytics" styleClass="menu-button" text="營運分析"/>
            <Button maxWidth="Infinity" onAction="#handleAlert" styleClass="menu-button" text="優先警示"/>
        </VBox>
    </center>
</BorderPane>
