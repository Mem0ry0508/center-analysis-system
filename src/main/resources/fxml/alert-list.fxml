<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.center.ui.AlertListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleBack" text="&lt; 返回主選單"/>
            <Label styleClass="title" text="優先警示"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleGenerate" text="產生警示"/>
            <Button onAction="#handleRefresh" text="依嚴重度(MaxHeap)"/>
            <Button onAction="#handleSortByDueDate" text="依到期日(MinHeap)"/>
            <Button onAction="#handleShowAll" text="顯示全部"/>
            <Button onAction="#handleAdd" text="新增警示"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="alertTypeColumn" prefWidth="120.0" text="類型"/>
                <TableColumn fx:id="severityColumn" prefWidth="70.0" text="嚴重度"/>
                <TableColumn fx:id="dueDateColumn" prefWidth="100.0" text="到期日"/>
                <TableColumn fx:id="priorityTierColumn" prefWidth="90.0" text="優先層級"/>
                <TableColumn fx:id="messageColumn" prefWidth="220.0" text="訊息"/>
                <TableColumn fx:id="statusColumn" prefWidth="80.0" text="狀態"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Button onAction="#handleRefresh" text="重新整理"/>
            <Button onAction="#handleResolve" text="標記已解決"/>
        </HBox>
    </bottom>
</BorderPane>
